// StreamingMesh keyframe and delta decoder.

#pragma kernel DecodeKeyframe
#pragma kernel DecodeDelta

struct KeyframeCommand
{
    uint vertexIndex;
    float3 position;
};

struct DeltaCommand
{
    uint vertexIndex;
    int x;
    int y;
    int z;
};

uint commandCount;
StructuredBuffer<KeyframeCommand> keyframeCommands;
StructuredBuffer<DeltaCommand> deltaCommands;
RWStructuredBuffer<float4> vertices;

[numthreads(128, 1, 1)]
void DecodeKeyframe(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= commandCount)
        return;

    KeyframeCommand command = keyframeCommands[index];
    vertices[command.vertexIndex] = float4(command.position, 1.0);
}

float DecodeComponent(int encoded)
{
    const float scale = 1.0 / 16384.0;
    return encoded < 0 ? -(encoded * encoded) * scale : (encoded * encoded) * scale;
}

[numthreads(128, 1, 1)]
void DecodeDelta(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= commandCount)
        return;

    DeltaCommand command = deltaCommands[index];
    vertices[command.vertexIndex].xyz += float3(
        DecodeComponent(command.x),
        DecodeComponent(command.y),
        DecodeComponent(command.z));
}
